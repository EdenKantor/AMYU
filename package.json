{
  "name": "amyu",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.12", "pnpm": ">=11.19.0 <12" },
  "scripts": {
    "dev": "pnpm --filter @amyu/avatar-lab dev",
    "dev:desktop": "pnpm --filter @amyu/desktop tauri dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @amyu/avatar-lab build && pnpm --filter @amyu/desktop build",
    "build:desktop": "pnpm --filter @amyu/desktop tauri build",
    "dev:desktop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/desktop/native.ps1 dev",
    "build:desktop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/desktop/native.ps1 build",
    "character:build": "node scripts/build-character.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
